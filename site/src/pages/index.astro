---
import MenuBar from "../components/MenuBar.astro";
import Panel from "../components/Panel.astro";
import Layout from "../layouts/Layout.astro";
import { fetchLatestDownload } from "../lib/releases";

const repo = "https://github.com/jakejarvis/Clicker";

// Rendered at build time, like the changelog: the button links straight to the
// newest release's DMG, and the release workflow redeploys the site after each
// release so it stays current. Without a DMG it falls back to the release page.
const latest = await fetchLatestDownload();
const downloadUrl = latest?.dmgUrl ?? `${repo}/releases/latest`;

const brewCommand = "brew install --cask jakejarvis/tap/clicker";
---

<Layout>
  <h1 class="lede">
    The missing <a
      href="https://www.apple.com/apple-tv-4k/"
      target="_blank"
      rel="noopener"
      class="apple-tv"
      aria-label="Apple TV"
      ><svg
        viewBox="0 0 384 512"
        width="0.8em"
        height="1em"
        fill="currentColor"
        aria-hidden="true"
        ><path
          d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.5 71.9 26.1 2 49.9-11.4 69.4-34.3z"
        ></path></svg
      >TV</a
    > remote for your Mac. Pause, rewind, swipe around, change the volume, launch
    apps, type with your Mac's keyboard, turn the TV off and more, all from the menu bar.
  </h1>

  <div class="install">
    <a class="download" href={downloadUrl}>
      <svg
        viewBox="0 0 384 512"
        width="1.1em"
        height="1.1em"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.5 71.9 26.1 2 49.9-11.4 69.4-34.3z"
        ></path>
      </svg>
      Download for Mac
    </a>
    <span class="install-alt">
      <span class="or muted">or</span>
      <button class="brew" type="button" data-copy={brewCommand} title="Copy to clipboard">
        <code>{brewCommand}</code>
        <svg
          class="copy-icon"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path
            d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path></svg
        >
        <svg
          class="check-icon"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
        >
      </button>
      <span class="sr-only" aria-live="polite"></span>
    </span>
  </div>

  <p class="requirements muted">Requires macOS 15 or later. Free and open source.</p>

  <figure class="shot">
    <MenuBar />
    <Panel />
  </figure>
</Layout>

<script>
  // The pill copies the command; the glyph turns into a check for a moment and
  // the live region says so. Without the Clipboard API (an insecure context),
  // the command is selected instead so ⌘C still works.
  const button = document.querySelector<HTMLButtonElement>(".brew");
  const status = document.querySelector<HTMLElement>(".install-alt .sr-only");
  let reset: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener("click", async () => {
    const command = button.dataset.copy ?? "";
    try {
      await navigator.clipboard.writeText(command);
    } catch {
      const code = button.querySelector("code");
      if (code) getSelection()?.selectAllChildren(code);
      return;
    }
    button.classList.add("copied");
    if (status) status.textContent = "Copied";
    clearTimeout(reset);
    reset = setTimeout(() => {
      button.classList.remove("copied");
      if (status) status.textContent = "";
    }, 1500);
  });
</script>
