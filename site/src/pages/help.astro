---
import Layout from "../layouts/Layout.astro";
import { repo, requirements } from "../lib/product";

interface Question {
  id: string;
  question: string;
  /** HTML, shown on the page and given to search engines as the answer. */
  answer: string;
}

const troubleshooting: Question[] = [
  {
    id: "not-found",
    question: "Clicker can't find my Apple TV",
    answer: `<p>Make sure your Mac and Apple TV are on the same network, and that Clicker is allowed under <strong>System Settings › Privacy & Security › Local Network</strong>. Without that permission Clicker can't see anything on your network, and the panel says so. If the Apple TV is asleep, wake it with its own remote. One that was just plugged in can take a minute to show up.</p>`,
  },
  {
    id: "pairing",
    question: "Pairing doesn't work",
    answer: `<p>On the Apple TV, open <strong>Settings › Remotes and Devices › Remote App and Devices</strong> and check that new devices are allowed to pair, then click <strong>Pair…</strong> in Clicker again. If you mistype the code, click <strong>Try Again</strong> for a new one.</p>`,
  },
  {
    id: "pair-again",
    question: "My Apple TV asks me to pair again",
    answer: `<p>The Apple TV was reset, or Clicker was removed from its list of remotes. Either way, the old pairing no longer works. Click <strong>Pair…</strong> and enter the new code.</p>`,
  },
  {
    id: "not-responding",
    question: "My Apple TV stopped responding",
    answer: `<p>Forget it in Clicker's Settings, under Paired Devices, and pair again.</p>`,
  },
  {
    id: "volume",
    question: "Volume and Mute don't do anything",
    answer: `<p>They control your TV or receiver only if the Apple TV does, through HDMI-CEC or an IR remote it has learned. You can check under <strong>Settings › Remotes and Devices › Volume Control</strong> on the Apple TV. If Mute has no effect on your setup, Clicker turns the button off after the first try.</p>`,
  },
  {
    id: "swipes",
    question: "Swipes go the wrong way",
    answer: `<p>Two-finger swipes over the clickpad move the TV's focus the way your fingers move, like the touch surface on the Siri Remote, whatever your Mac's scrolling setting. If you'd rather swipes move the content, set <strong>Swipe Direction</strong> to Inverted in Settings.</p>`,
  },
  {
    id: "where",
    question: "Where's the window or Dock icon?",
    answer: `<p>There isn't one. Clicker lives in the menu bar: click its icon to open the remote, or right-click it for Settings, About and Quit. You can also set a keyboard shortcut in Settings that opens the remote from any app.</p>`,
  },
];

const general: Question[] = [
  {
    id: "updates",
    question: "How do I update Clicker?",
    answer: `<p>The version from this site or Homebrew checks for updates once a day and shows a notice under the remote when one is ready. You can check yourself with <strong>Check for Updates…</strong> in the ••• menu. The Mac App Store version is updated by the App Store.</p>`,
  },
  {
    id: "requirements",
    question: "What do I need to use Clicker?",
    answer: `<p>${requirements} Your Apple TV needs to be on the same network as your Mac. There's nothing to install on the Apple TV and no account to make.</p>`,
  },
  {
    id: "free",
    question: "Is Clicker really free?",
    answer: `<p>Yes. Clicker is free and open source under the MIT license, with no ads, subscriptions or in-app purchases. The source code is <a href="${repo}">on GitHub</a>.</p>`,
  },
  {
    id: "how",
    question: "How does Clicker talk to my Apple TV?",
    answer: `<p>Directly, over your local network, using Apple's Companion protocol: the same one the Apple TV Remote on an iPhone uses. After pairing, the connection is encrypted between your Mac and the Apple TV, and nothing passes through a server. See the <a href="/privacy">privacy policy</a> for the details.</p>`,
  },
];

// Every question on the page, for search engines and AI assistants.
const jsonLd = {
  "@type": "FAQPage",
  mainEntity: [...troubleshooting, ...general].map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Layout
  title="Help — Clicker"
  description="Answers to common questions about Clicker, the free Apple TV remote for Mac, and how to report a problem."
  jsonLd={jsonLd}
>
  <article class="prose">
    <h1>Help</h1>
    <p class="muted">
      Answers to the questions that come up most. If yours isn't here, <a
        href="#report">report an issue</a
      >.
    </p>

    {
      troubleshooting.map(({ id, question, answer }) => (
        <>
          <h2 id={id}>{question}</h2>
          <Fragment set:html={answer} />
        </>
      ))
    }

    <h2 id="keyboard">Keyboard shortcuts</h2>
    <p>While the panel is open you can leave the mouse alone:</p>
    <table class="keys">
      <thead>
        <tr><th scope="col">Key</th><th scope="col">Does</th></tr>
      </thead>
      <tbody>
        <tr><td>Arrow keys</td><td>Move</td></tr>
        <tr><td><kbd>Return</kbd></td><td>Select</td></tr>
        <tr><td><kbd>Delete</kbd></td><td>Back</td></tr>
        <tr><td><kbd>Space</kbd> or <kbd>P</kbd></td><td>Play/Pause</td></tr>
        <tr><td><kbd>H</kbd> or <kbd>T</kbd></td><td>TV (Home)</td></tr>
        <tr><td>Hold <kbd>S</kbd></td><td>Siri</td></tr>
        <tr><td><kbd>M</kbd></td><td>Mute</td></tr>
        <tr><td><kbd>+</kbd> and <kbd>−</kbd></td><td>Volume up and down</td></tr>
        <tr><td><kbd>⌘,</kbd></td><td>Settings</td></tr>
        <tr><td><kbd>Esc</kbd></td><td>Close the panel</td></tr>
      </tbody>
    </table>
    <p>
      Hold an arrow key to keep moving, as you would hold the clickpad on the Siri
      Remote. Hover over any button to see its shortcut.
    </p>

    {
      general.map(({ id, question, answer }) => (
        <>
          <h2 id={id}>{question}</h2>
          <Fragment set:html={answer} />
        </>
      ))
    }

    <h2 id="report">Report an issue</h2>
    <p>
      Something broken, or a question that isn't answered here? Open an issue on
      GitHub. It helps to include your Clicker version (click it in <strong
        >About Clicker</strong
      > to copy it), your macOS version, your Apple TV model and what you expected
      to happen.
    </p>
  </article>

  <p class="help-report">
    <a class="download" href={`${repo}/issues/new`} target="_blank" rel="noopener">
      Report an Issue on GitHub
    </a>
  </p>
</Layout>
