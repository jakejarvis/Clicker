---
import Layout from "../layouts/Layout.astro";
import { fetchReleases } from "../lib/releases";

// Rendered at build time. A failed GitHub request throws and fails the build,
// so a broken page is never deployed; redeploy (or push) to pick up a release.
const releases = await fetchReleases();

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Changelog — Clicker"
  description="Clicker release notes and downloads."
>
  <div class="changelog">
    <h1>Changelog</h1>

    {
      releases.length === 0 ? (
        <p class="muted">No releases yet.</p>
      ) : (
        <div class="releases">
          {releases.map((release) => (
            <article id={release.tag_name} class="release">
              <h2 class="release-tag">
                <a href={`#${release.tag_name}`}>{release.tag_name}</a>
              </h2>

              <div class="release-meta">
                {release.published_at && (
                  <>
                    <time datetime={release.published_at}>
                      {dateFormatter.format(new Date(release.published_at))}
                    </time>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                  </>
                )}
                <a href={release.html_url} target="_blank" rel="noopener">
                  GitHub
                </a>
                {release.downloads.dmgUrl && (
                  <>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                    <a class="download-link" href={release.downloads.dmgUrl}>
                      DMG
                    </a>
                  </>
                )}
                {release.downloads.zipUrl && (
                  <>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                    <a class="download-link" href={release.downloads.zipUrl}>
                      ZIP
                    </a>
                  </>
                )}
              </div>

              {release.body_html && (
                <div class="release-body" set:html={release.body_html} />
              )}
            </article>
          ))}
        </div>
      )
    }
  </div>
</Layout>
