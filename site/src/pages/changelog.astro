---
import Layout from "../layouts/Layout.astro";
import { type Release, fetchReleases } from "../lib/releases";

export const prerender = false;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

let releases: Release[] | null;
try {
  releases = await fetchReleases();
  // cache on Vercel's edge for 10 minutes
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=600, stale-while-revalidate=86400",
  );
} catch (error) {
  console.error("Failed to load releases", error);
  releases = null;
  Astro.response.headers.set("Cache-Control", "no-store");
}
---

<Layout title="Changelog — Clicker" description="Clicker release notes and downloads.">
  <div class="changelog">
    <h1>Changelog</h1>

    {
      releases === null ? (
        <p class="muted">
          Couldn't load releases right now. See them on{" "}
          <a class="link" href="https://github.com/jakejarvis/Clicker/releases">
            GitHub
          </a>
          .
        </p>
      ) : releases.length === 0 ? (
        <p class="muted">No releases yet.</p>
      ) : (
        <div class="releases">
          {releases.map((release) => (
            <article id={release.tag_name} class="release">
              <a class="release-tag" href={`#${release.tag_name}`}>
                {release.tag_name}
              </a>

              <div class="release-meta">
                {release.published_at && (
                  <>
                    <time datetime={release.published_at}>
                      {dateFormatter.format(new Date(release.published_at))}
                    </time>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                  </>
                )}
                <a href={release.html_url} target="_blank" rel="noopener">
                  GitHub
                </a>
                {release.downloads.dmgUrl && (
                  <>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                    <a class="download-link" href={release.downloads.dmgUrl}>
                      DMG
                    </a>
                  </>
                )}
                {release.downloads.zipUrl && (
                  <>
                    <span class="slash" aria-hidden="true">
                      /
                    </span>
                    <a class="download-link" href={release.downloads.zipUrl}>
                      ZIP
                    </a>
                  </>
                )}
              </div>

              {release.body_html && <div class="release-body" set:html={release.body_html} />}
            </article>
          ))}
        </div>
      )
    }
  </div>
</Layout>
