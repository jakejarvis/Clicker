---
import "../styles/global.css";
import { Font, Image } from "astro:assets";
import icon from "../assets/icon.png";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
}

const repo = "https://github.com/jakejarvis/Clicker";
const {
  title = "Clicker — Apple TV remote for your Mac",
  description = "A native macOS menu bar remote for Apple TV. Pairs once, speaks Apple's own protocol, and stays out of your way.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Clicker updates" href="/appcast.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/icon.png", Astro.site)} />
    <Analytics />
  </head>
  <body>
    <div class="page">
      <header>
        <a class="brand" href="/">
          <Image src={icon} alt="" width={24} height={24} densities={[1, 2]} priority />
          <span class="name">Clicker</span>
        </a>
        <nav>
          <a class="nav-link" href={`${repo}/releases`}>Changelog</a>
          <span class="separator" aria-hidden="true"></span>
          <a class="nav-icon" href={repo} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 1C5.923 1 1 5.923 1 12c0 4.867 3.149 8.979 7.521 10.436c.55.096.756-.233.756-.522c0-.262-.013-1.128-.013-2.049c-2.764.509-3.479-.674-3.699-1.292c-.124-.317-.66-1.293-1.127-1.554c-.385-.207-.936-.715-.014-.729c.866-.014 1.485.797 1.691 1.128c.99 1.663 2.571 1.196 3.204.907c.096-.715.385-1.196.701-1.471c-2.448-.275-5.005-1.224-5.005-5.432c0-1.196.426-2.186 1.128-2.956c-.111-.275-.496-1.402.11-2.915c0 0 .921-.288 3.024 1.128a10.2 10.2 0 0 1 2.75-.371c.936 0 1.871.123 2.75.371c2.104-1.43 3.025-1.128 3.025-1.128c.605 1.513.221 2.64.111 2.915c.701.77 1.127 1.747 1.127 2.956c0 4.222-2.571 5.157-5.019 5.432c.399.344.743 1.004.743 2.035c0 1.471-.014 2.654-.014 3.025c0 .289.206.632.756.522C19.851 20.979 23 16.854 23 12c0-6.077-4.922-11-11-11"
              ></path>
            </svg>
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <div class="footer-row">
          <p>
            Created by{" "}
            <a class="footer-credit" href="https://jarv.is" target="_blank" rel="noopener">
              <span>@jakejarvis</span><svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
              >
            </a>
          </p>
          <nav>
            <a href="/privacy">Privacy</a>
            <span class="bullet" aria-hidden="true">•</span>
            <a href="/terms">Terms</a>
          </nav>
        </div>
        <p class="disclaimer">
          Clicker is an independent project, not affiliated with or endorsed by Apple Inc. Apple TV
          and macOS are trademarks of Apple Inc.
        </p>
      </footer>
    </div>
  </body>
</html>
