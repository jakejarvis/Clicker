---
import "../styles/global.css";
import { Font, Image } from "astro:assets";
import icon from "../assets/icon.png";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
}

const repo = "https://github.com/jakejarvis/Clicker";
const {
  title = "Clicker — Apple TV remote for your Mac",
  description = "A native macOS menu bar remote for Apple TV. Pairs once, speaks Apple's own protocol, and stays out of your way.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Clicker updates" href="/appcast.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/icon.png", Astro.site)} />
    <Analytics />
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href="/">
          <Image src={icon} alt="" width={32} height={32} densities={[1, 2]} priority />
          <span class="name">Clicker</span>
        </a>
        <nav>
          <a href={`${repo}/releases`}>Changelog</a>
          <span class="divider" aria-hidden="true"></span>
          <a href={repo} aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="1.4em" height="1.4em" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </nav>
      </header>

      <slot />

      <footer>
        <div class="footer-row">
          <span>
            Created by <a class="underline" href="https://jarv.is">@jakejarvis</a>{" "}
            <span aria-hidden="true">↗</span>
          </span>
          <nav>
            <a href="/privacy">Privacy</a>
            <span aria-hidden="true">•</span>
            <a href="/terms">Terms</a>
          </nav>
        </div>
        <p class="disclaimer">
          Clicker is an independent project, not affiliated with or endorsed by Apple Inc. Apple TV
          and macOS are trademarks of Apple Inc.
        </p>
      </footer>
    </main>
  </body>
</html>
